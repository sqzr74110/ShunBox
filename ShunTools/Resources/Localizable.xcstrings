    "本应用不提供原装鉴定、拆修判定、激活锁查询或刷机服务。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not certify original parts, determine repairs, query Activation Lock or flash firmware."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純正判定、分解・修理歴の判定、アクティベーションロック照会、ファームウェア書き換えは行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不提供原装鉴定、拆修判定、激活锁查询或刷机服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用不提供原裝鑒定、拆修判定、激活鎖查詢或刷機服務。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순정 판정, 수리 판정, 활성화 잠금 조회, 펌웨어 설치는 제공하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de certification des pièces, de diagnostic de réparations, de recherche du verrouillage d’activation ni de flashage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Teilezertifizierung, Reparaturbewertung, Aktivierungssperrenabfrage oder Firmwareinstallation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No certifica piezas, reparaciones ni bloqueos de activación, ni instala firmware."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não certifica peças ou reparos, consulta Bloqueio de Ativação nem instala firmware."
          }
        }
      }
    },
