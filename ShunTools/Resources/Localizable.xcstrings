    "铃声最长 30 秒。推荐 29 秒来电铃声，或 3–5 秒短提示音。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringtones can be up to 30 seconds. Try 29 seconds for calls or 3–5 seconds for alerts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着信音は最大30秒です。着信は29秒、通知音は3〜5秒がおすすめです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铃声最长 30 秒。推荐 29 秒来电铃声，或 3–5 秒短提示音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鈴聲最長 30 秒。推薦 29 秒來電鈴聲，或 3–5 秒短提示音。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벨소리는 최대 30초. 전화는 29초, 알림은 3~5초를 권장합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 secondes maximum. Essayez 29 secondes pour les appels, 3 à 5 pour les alertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens 30 Sekunden. Empfehlung: 29 für Anrufe, 3–5 für Hinweise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo 30 segundos. Prueba 29 para llamadas y 3–5 para avisos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo de 30 segundos. Use 29 para chamadas e 3–5 para alertas."
          }
        }
      }
    },
