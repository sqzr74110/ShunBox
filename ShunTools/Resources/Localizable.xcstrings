    "请检查裁剪区间；铃声长度不能超过 30 秒。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the trim range. Ringtones must be 30 seconds or shorter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲を確認してください。着信音は30秒以内にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查裁剪区间；铃声长度不能超过 30 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查裁剪區間；鈴聲長度不能超過 30 秒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구간을 확인하세요. 벨소리는 30초 이하여야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la plage. Les sonneries ne doivent pas dépasser 30 secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereich prüfen. Klingeltöne dürfen höchstens 30 Sekunden dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el rango. Los tonos deben durar como máximo 30 segundos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o intervalo. Toques devem ter no máximo 30 segundos."
          }
        }
      }
    },
